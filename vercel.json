{
  "crons": [
    { "path": "/api/cron/update-allowlist", "schedule": "0 3 * * 6" },
    { "path": "/api/cron/clear-allowlist", "schedule": "0 3 * * 0" }
  ],
  "headers": [
    {
      "source": "/UnityBuild/(.*)/Build/(.*).wasm.br",
      "headers": [
        { "key": "Content-Type", "value": "application/wasm" },
        { "key": "Content-Encoding", "value": "br" },
        { "key": "Vary", "value": "Accept-Encoding" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/UnityBuild/(.*)/Build/(.*).data.br",
      "headers": [
        { "key": "Content-Type", "value": "application/octet-stream" },
        { "key": "Content-Encoding", "value": "br" },
        { "key": "Vary", "value": "Accept-Encoding" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/UnityBuild/(.*)/Build/(.*).js.br",
      "headers": [
        { "key": "Content-Type", "value": "application/javascript; charset=utf-8" },
        { "key": "Content-Encoding", "value": "br" },
        { "key": "Vary", "value": "Accept-Encoding" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/UnityBuild/(.*)/Build/(.*).loader.js",
      "headers": [
        { "key": "Content-Type", "value": "application/javascript; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/UnityBuild/Build/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
